---
import Icon from "./Icon.astro";
import { phones, instagram } from "../data/club";
---
<section id="first-visit" class="fv section" data-rec="R-002" aria-labelledby="fv-title">
  <div class="container fv__grid">
    <div class="fv__head">
      <h2 id="fv-title" class="fv__title">Перше тренування — безкоштовно</h2>
      <p class="lead">Зателефонуйте — підкажемо групу, час і тренера для вас або дитини.</p>
    </div>
    <ul class="fv__phones">
      {phones.map((p, i) => (
        <li>
          <a class:list={["fv__call", i === 0 ? "brama brama--dark" : "fv__call--line"]} href={p.href}>
            <span class="fv__num">{p.label}</span>
            <span class="fv__who">{p.who}</span>
            <Icon name="phone" class="fv__icon" />
          </a>
        </li>
      ))}
    </ul>
    <div class="fv__notes">
      <p>Для клубної картки знадобиться медична довідка.</p>
      <p>Життя клубу щодня — в Instagram <a class="text-link" href={instagram.href} target="_blank" rel="noopener">{instagram.handle}<span class="visually-hidden"> (нова вкладка)</span></a></p>
    </div>
  </div>
</section>

<style>
  .fv { background: var(--color-accent); color: var(--color-on-accent); }
  .fv__grid { display: grid; gap: var(--s-6); }
  .fv__head { display: grid; gap: var(--s-4); }
  .fv__title { font-size: var(--fs-h1); line-height: var(--lh-h1); max-width: 12ch; }
  .fv__head .lead { max-width: 36ch; }
  .fv__phones { display: grid; gap: var(--s-3); }
  .fv__call {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto auto; column-gap: var(--s-4); row-gap: var(--s-1); align-items: center;
    justify-content: stretch; width: 100%; min-height: 5rem; padding: var(--s-3) calc(var(--notch) + var(--s-5)); text-align: left; text-decoration: none;
  }
  .fv__call--line { border: var(--seam) solid var(--color-on-accent); color: var(--color-on-accent); transition: background-color var(--dur-nudge) var(--ease-out), color var(--dur-nudge) var(--ease-out), transform var(--dur-press) var(--ease-out); }
  .fv__call--line:hover { background: var(--color-on-accent); color: var(--color-accent); }
  .fv__call--line:active { transform: scale(.98); }
  .fv__num { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 1.2rem + 2.2vw, 3rem); line-height: 1; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .fv__who { grid-row: 2; font-weight: 400; }
  .fv__call :global(.fv__icon) { grid-row: 1 / span 2; grid-column: 2; width: 1.75rem; height: 1.75rem; }
  .fv__notes { display: grid; gap: var(--s-2); }
  @media (min-width: 1024px) {
    .fv__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s-6); align-items: end; }
    .fv__head { grid-column: 1 / span 6; grid-row: 1 / span 2; align-self: start; }
    .fv__phones { grid-column: 8 / span 5; }
    .fv__notes { grid-column: 8 / span 5; }
  }
  @media (prefers-reduced-motion: reduce) {
    .fv__call--line:active { transform: none; }
  }
</style>
