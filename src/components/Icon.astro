---
// Inline stroke icons (decorative, aria-hidden). Colour follows currentColor.
interface Props { name: "arrow" | "phone" | "menu" | "close" | "pin"; class?: string; }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="square" aria-hidden="true" focusable="false">
  {name === "arrow" && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === "phone" && <path d="M5 3h4l2 5-2.5 1.5a11 11 0 0 0 6 6L16 13l5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 3 5a2 2 0 0 1 2-2Z" />}
  {name === "menu" && <path d="M3 7h18M3 12h18M3 17h18" />}
  {name === "close" && <path d="M5 5l14 14M19 5L5 19" />}
  {name === "pin" && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>}
</svg>
