---
import { disciplines, tabs, formatLabel, phones } from "../data/club";
---
<section id="disciplines" class="disc section" data-rec="R-012,R-004" aria-labelledby="disc-title">
  <div class="container disc__grid">
    <figure class="disc__photo" data-rec="R-009">
      <img
        src="/img/zal-800.webp"
        srcset="/img/zal-480.webp 480w, /img/zal-800.webp 800w, /img/zal-1080.webp 1080w"
        sizes="(min-width: 1024px) 40vw, 100vw"
        width="1080" height="500" alt="Дві спортсменки з гантелями в силовому залі клубу" loading="lazy" decoding="async" />
      <figcaption class="small muted">Силовий зал клубу «Бастіон»</figcaption>
    </figure>

    <div class="disc__body">
      <h2 id="disc-title">Дев'ять дисциплін у залах на Трильовського, 12</h2>

      <div class="tabs" id="disc-tabs" data-tabs>
        <div class="tabs__list" role="tablist" aria-label="Для кого заняття" hidden>
          {tabs.map((t, i) => (
            <button class="tabs__tab" type="button" role="tab" id={`tab-${t.id}`} aria-controls={`panel-${t.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-tab={t.id}>{t.label}</button>
          ))}
          <span class="tabs__indicator" aria-hidden="true"></span>
        </div>

        {tabs.map((t) => (
          <div class="tabs__panel" role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} data-panel={t.id}>
            <h3 class="tabs__panel-title">{t.title}</h3>
            <ul class="rows">
              {disciplines.filter((d) => d.tabs.includes(t.id)).map((d) => (
                <li class="row" data-disc={d.id}>
                  <span class="row__name">{d.name}</span>
                  <span class="row__format small muted">{formatLabel[t.id]}</span>
                  <span class="row__note">{d.note}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <p class="disc__ask lead">
        Вік, розклад і тренера групи підкажемо телефоном:
        <a class="text-link" href={phones[0].href}>{phones[0].label}</a>
      </p>
    </div>
  </div>
</section>

<script>
  import { initTabs } from "../scripts/tabs";
  initTabs();
</script>

<style>
  .disc { background: var(--color-bg); }
  .disc__grid { display: grid; gap: var(--s-7); }
  .disc__photo { display: grid; gap: var(--s-2); }
  .disc__photo img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: 50% 35%; }
  .disc__body { display: grid; gap: var(--s-6); align-content: start; min-width: 0; }
  .disc__body h2 { max-width: 18ch; text-wrap: balance; }

  .tabs { display: grid; gap: var(--s-5); }
  .tabs__list { position: relative; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-bottom: var(--seam) solid var(--color-yard); }
  .tabs__list[hidden] { display: none; }
  .tabs__tab {
    min-height: var(--tap); padding: var(--s-2) var(--s-1); background: none; border: 0; cursor: pointer;
    font-size: clamp(0.875rem, 0.8rem + 0.4vw, 1.125rem); font-weight: 600; color: var(--color-text-muted);
    transition: color var(--dur-nudge) var(--ease-out);
  }
  .tabs__tab:hover, .tabs__tab[aria-selected="true"] { color: var(--color-text); }
  .tabs__tab:focus-visible { outline-offset: -2px; }
  .tabs__indicator {
    position: absolute; left: 0; bottom: calc(-1 * var(--seam)); width: calc(100% / 3); height: 4px;
    background: var(--color-text); transform: translateX(calc(var(--tab-index, 0) * 100%));
    transition: transform var(--dur-tab) var(--ease-out);
  }
  .tabs__panel { display: grid; gap: var(--s-4); }
  .tabs__panel[hidden] { display: none; }
  .tabs__panel.is-entering .row { animation: row-in 240ms var(--ease-out) backwards; }
  .tabs__panel-title { font-size: var(--fs-lead); line-height: 1.2; font-weight: 800; }
  :global(.js) .tabs__panel-title { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @keyframes row-in { from { opacity: 0; transform: translateY(8px); } }

  .rows { display: grid; }
  .row { display: grid; gap: var(--s-1); padding: var(--s-4) var(--s-3); border-top: var(--seam) solid var(--color-yard); transition: background-color var(--dur-tab) var(--ease-out); }
  .row:last-child { border-bottom: var(--seam) solid var(--color-yard); }
  .row__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.5rem); line-height: 1; }
  .row__note { color: var(--color-text); }
  .row.is-picked { background: var(--color-yard); }
  .disc__ask a { white-space: nowrap; }

  @media (min-width: 768px) {
    .row { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: var(--gutter); align-items: baseline; }
    .row__name { grid-row: 1 / span 2; }
  }
  @media (min-width: 1024px) {
    .disc { padding-block: var(--s-11); }
    .disc__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .disc__photo { grid-column: 1 / span 5; position: sticky; top: calc(var(--header-h) + var(--s-6)); }
    .disc__photo img { aspect-ratio: 4 / 5; }
    .disc__body { grid-column: 7 / span 6; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tabs__panel.is-entering .row { animation: none; }
  }
</style>
